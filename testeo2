                    </div>

                    <div style="margin-top:16px; display:flex; gap:10px;">
                        <button type="button" class="btn btn-primary" onclick="generarCotizacionPDF('celosia')">Impresión</button>
                        <button type="button" class="btn btn-warning" onclick="previewCotizacion('celosia')">Previsualizar</button>
                        <button type="button" class="btn btn-success" id="cotBtnDescargar_celosia" onclick="descargarCotizacionPDF('celosia')">Descargar PDF</button>
                    </div>
                </form>
            </div>

            <!-- Módulo Bordado -->
            <div id="cot-module-bordado" class="cot-module" style="display:none">
                <form id="formCot_bordado">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cotFolio_bordado">Folio</label>
                            <input type="text" id="cotFolio_bordado" placeholder="COT-BO-0001">
                        </div>
                        <div class="form-group">
                            <label for="cotFecha_bordado">Fecha</label>
                            <input type="date" id="cotFecha_bordado" value="">
                        </div>
                        <div class="form-group">
                            <label for="clienteCot_bordado">Cliente (Nombre)</label>
                            <input type="text" id="clienteCot_bordado" placeholder="Nombre del cliente">
                        </div>
                    </div>
                    <div style="margin-top:12px;">
                        <label>Items (Bordado)</label>
                        <table style="width:100%; border-collapse: collapse; margin-top:8px;">
                            <thead>
                                <tr style="background:#f5f5f5;">
                                    <th style="padding:8px; text-align:left;">Descripción</th>
                                    <th style="padding:8px; width:100px;">Cantidad</th>
                                    <th style="padding:8px; width:140px;">Precio Unitario</th>
                                    <th style="padding:8px; width:120px;">Total</th>
                                    <th style="padding:8px; width:80px;"></th>
                                </tr>
                            </thead>
                            <tbody id="cotItemsBody_bordado">
                                <tr>
                                    <td><input type="text" class="cot-desc" placeholder="Descripción"></td>
                                    <td><input type="number" class="cot-cant" value="1" min="1"></td>
                                    <td><input type="number" class="cot-precio" value="0" step="0.01" min="0"></td>
                                    <td class="cot-total">$0.00</td>
                                    <td><button type="button" class="btn btn-danger" onclick="this.closest('tr').remove(); updateCotTotals('bordado');">Eliminar</button></td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="margin-top:8px; text-align:right;">
                            <button type="button" class="btn btn-secondary" onclick="agregarItemCot('bordado')">Agregar</button>
