                            <label><input type="checkbox" id="cotServDiseno_bordado" checked> Diseño</label>
                            <label><input type="checkbox" id="cotServConsumibles_bordado"> Consumibles</label>
                            <label><input type="checkbox" id="cotServCNC_bordado"> CNC</label>
                        </div>
                    </div>
                    <div style="margin-top:12px;">
                        <label for="cotNotas_bordado">Notas de la propuesta (Editable)</label>
                        <textarea id="cotNotas_bordado" rows="3" placeholder="Observaciones, tiempos de entrega, alcance del servicio o condiciones especiales." style="width:100%; margin-top:6px; padding:8px 10px; border:1px solid #ccc; border-radius:4px; font-family:inherit; font-size:14px; resize:vertical;"></textarea>
                    </div>

                    <div style="margin-top:16px; display:flex; gap:10px;">
                        <button type="button" class="btn btn-primary" onclick="generarCotizacionPDF('bordado')">Impresión</button>
                        <button type="button" class="btn btn-warning" onclick="previewCotizacion('bordado')">Previsualizar</button>
                        <button type="button" class="btn btn-success" id="cotBtnDescargar_bordado" onclick="descargarCotizacionPDF('bordado')">Descargar PDF</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        const cotPrefixes = ['celosia','bordado'];

        function switchCotTab(tab){
            const generalEl = document.getElementById('cot-module-general');
            if(tab === 'general'){
                if(generalEl) generalEl.style.display = 'block';
                cotPrefixes.forEach(pref => {
                    const el = document.getElementById('cot-module-'+pref);
                    if(el) el.style.display = 'none';
                });
                return;
            }

            if(generalEl) generalEl.style.display = 'none';
            cotPrefixes.forEach(pref => {
                const el = document.getElementById('cot-module-'+pref);
                if(!el) return;
                el.style.display = (pref === tab) ? 'block' : 'none';
            });
        }

        function agregarItemCot(prefix){
            const tbody = document.getElementById('cotItemsBody_' + prefix);
            if(!tbody) return;
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><input type="text" class="cot-desc" placeholder="Descripción"></td>
                <td><input type="number" class="cot-cant" value="1" min="1" onchange="updateCotTotals('${prefix}')"></td>
                <td><input type="number" class="cot-precio" value="0" step="0.01" min="0" onchange="updateCotTotals('${prefix}')"></td>
                <td class="cot-total">$0.00</td>
                <td><button type="button" class="btn btn-danger" onclick="this.closest('tr').remove(); updateCotTotals('${prefix}');">Eliminar</button></td>
            `;
            tbody.appendChild(row);
        }

        function agregarItemCot(){
            const tbody = document.getElementById('cotItemsBody');
            if(!tbody) return agregarItemCot('general');
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><input type="text" class="cot-desc" placeholder="Descripción"></td>
                <td><input type="number" class="cot-cant" value="1" min="1" oninput="actualizarTotalesCot()"></td>
                <td><input type="number" class="cot-precio" value="0" step="0.01" min="0" oninput="actualizarTotalesCot()"></td>
                <td class="cot-total">$0.00</td>
                <td><button type="button" class="btn btn-danger" onclick="eliminarItemCot(this)">Eliminar</button></td>
            `;
            tbody.appendChild(row);
            actualizarTotalesCot();
        }

        function updateCotTotals(prefix){
            const rows = document.querySelectorAll('#' + (prefix ? 'cotItemsBody_' + prefix : 'cotItemsBody') + ' tr');
            let subtotal = 0;
            rows.forEach(r => {
                const cant = parseFloat(r.querySelector('.cot-cant')?.value || 0);
                const precio = parseFloat(r.querySelector('.cot-precio')?.value || 0);
                const total = (cant * precio) || 0;
                const totalCell = r.querySelector('.cot-total');
                if(totalCell) totalCell.textContent = '$' + total.toFixed(2);
                subtotal += total;
            });
            const subtotalEl = document.getElementById(prefix ? 'cotSubtotal_' + prefix : 'cotSubtotal');
            if(subtotalEl) subtotalEl.textContent = '$' + subtotal.toFixed(2);
        }

        function actualizarTotalesCot() {
            const rows = document.querySelectorAll('#cotItemsBody tr');
            let subtotal = 0;
            rows.forEach(row => {
                const cant = parseFloat(row.querySelector('.cot-cant')?.value) || 0;
                const precio = parseFloat(row.querySelector('.cot-precio')?.value) || 0;
                const total = cant * precio;
                const tdTotal = row.querySelector('.cot-total');
                if (tdTotal) tdTotal.textContent = formatMoney(total);
                subtotal += total;
            });
            const subtotalEl = document.getElementById('cotSubtotal');
            if (subtotalEl) subtotalEl.textContent = formatMoney(subtotal);
            return subtotal;
        }

        function formatMoney(v) { return '$' + (v || 0).toFixed(2); }

        const CL_UNIDADES = ['', 'un', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez',
            'once', 'doce', 'trece', 'catorce', 'quince', 'diecisiete', 'dieciocho', 'diecinueve', 'veinte'];
        const CL_DECENAS = ['', '', 'veinti', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta', 'ochenta', 'noventa'];
        const CL_CENTENAS = ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos', 'seiscientos', 'setecientos', 'ochocientos', 'novecientos'];

        function clDecenasLetras(n) {
            if (n < 21) return CL_UNIDADES[n];
            const decena = Math.floor(n / 10);
            const unidad = n % 10;
            if (n < 30) return unidad === 0 ? 'veinte' : (unidad === 1 ? 'veintiún' : 'veinti' + CL_UNIDADES[unidad]);
            return unidad === 0 ? CL_DECENAS[decena] : CL_DECENAS[decena] + ' y ' + CL_UNIDADES[unidad];
        }

        function clCentenasLetras(n) {
            if (n === 100) return 'cien';
            const centena = Math.floor(n / 100);
            const resto = n % 100;
            let str = CL_CENTENAS[centena];
            if (resto > 0) str += (str ? ' ' : '') + clDecenasLetras(resto);
            return str;
        }

        function clSeccionLetras(n) {
            if (n === 0) return '';
            if (n < 21) return CL_UNIDADES[n];
            if (n < 100) return clDecenasLetras(n);
            return clCentenasLetras(n);
        }

