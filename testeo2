<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TechnoMaQ - Cotizado en línea</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        .servicio-selector { display:flex; flex-wrap:wrap; gap:24px; align-items:center; row-gap:12px; }
        .servicio-selector label {
            display:flex; align-items:center; gap:9px; font-weight:400; font-size:14px;
            color:#333; cursor:pointer; white-space:nowrap; margin:0;
        }
        .servicio-selector input[type="checkbox"] {
            appearance:none; -webkit-appearance:none; -moz-appearance:none;
            width:17px; height:17px; margin:0; border-radius:50%;
            border:2px solid #b8b8b8; background:#fff; cursor:pointer;
            position:relative; flex-shrink:0; transition:border-color .15s ease;
        }
        .servicio-selector input[type="checkbox"]:hover { border-color:#888; }
        .servicio-selector input[type="checkbox"]:checked { border-color:#ef6c00; }
        .servicio-selector input[type="checkbox"]:checked::after {
            content:''; position:absolute; top:3px; left:3px; width:7px; height:7px;
            border-radius:50%; background:#ef6c00;
        }
        .servicio-selector-title { font-weight:700; display:block; margin-bottom:12px; color:#222; }
    </style>
</head>
<body>
    <header class="header">
        <img src="LogoT.png" alt="TechnoMaQ Logo" class="header-logo">
        <div class="header-content">
            <h1>TechnoMaQ</h1>
            <p class="subtitle">Cotizado en línea</p>
        </div>
    </header>

    <nav class="main-nav" style="display:flex; gap:12px; padding:12px; background:#fff; border-bottom:1px solid #e6e6e6;">
        <a class='nav-link' href='/' style='text-decoration:none;'>Inventario</a>
        <a class='nav-link active' href='/cotizado_en_linea' style='text-decoration:none; font-weight:700;'>Cotizado en línea</a>
        <a class='nav-link' href='/contabilidad' style='text-decoration:none;'>Contabilidad</a>
        <a class='nav-link' href='/technoblock' style='text-decoration:none;'>TechnoBlock</a>
    </nav>

    <main class="container" style="padding:20px;">
        <h2>Generar Cotización</h2>
        <div class="note-card">
            <div style="display:flex; gap:8px; margin-bottom:12px;">
                <button type="button" class="btn" onclick="switchCotTab('general')">General</button>
                <button type="button" class="btn" onclick="switchCotTab('celosia')">Celosía</button>
                <button type="button" class="btn" onclick="switchCotTab('bordado')">Bordado</button>
            </div>

            <!-- Módulo General (cotización original) -->
            <div id="cot-module-general" class="cot-module" style="display:block">
                <form id="formCotizacion">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cotFolio">Folio</label>
                            <input type="text" id="cotFolio" placeholder="COT-0001">
                        </div>
                        <div class="form-group">
                            <label for="cotFecha">Fecha</label>
                            <input type="date" id="cotFecha" value="">
                        </div>
                        <div class="form-group">
                            <label for="clienteCot">Cliente (Nombre)</label>
                            <input type="text" id="clienteCot" placeholder="Nombre del cliente">
                        </div>
                        <div class="form-group">
                            <label for="telefonoCot">Teléfono</label>
                            <input type="tel" id="telefonoCot" placeholder="Ej: +52 311 123 4567">
                        </div>
                        <div class="form-group">
                            <label for="correoCot">Correo</label>
                            <input type="text" id="correoCot" placeholder="cliente@ejemplo.com (opcional)">
                        </div>
                        <div class="form-group">
                            <label for="cotMetodoPago">Método de Pago</label>
                            <select id="cotMetodoPago">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Transferencia">Transferencia</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="Crédito">Crédito</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="atiendeCot">Atiende (Nombre)</label>
                            <input type="text" id="atiendeCot" placeholder="Nombre de la persona que atiende">
                        </div>
                    </div>

                    <div style="margin-top:16px;">
                        <label class="servicio-selector-title">Tipo de Servicio</label>
                        <div class="servicio-selector">
                            <label><input type="checkbox" id="cotServRefacciones"> Refacciones</label>
                            <label><input type="checkbox" id="cotServTecnico"> Servicio técnico</label>
                            <label><input type="checkbox" id="cotServPreventivo"> Mantenimiento Preventivo</label>
                            <label><input type="checkbox" id="cotServCorrectivo"> Mantenimiento correctivo</label>
                            <label><input type="checkbox" id="cotServRenta"> Renta de equipo</label>
                            <label><input type="checkbox" id="cotServVenta"> Venta de equipo</label>
                            <label><input type="checkbox" id="cotServCorte"> Corte / maquila</label>
                            <label><input type="checkbox" id="cotServDiseno"> Diseño</label>
                            <label><input type="checkbox" id="cotServConsumibles"> Consumibles</label>
                            <label><input type="checkbox" id="cotServCNC"> CNC</label>
                        </div>
                    </div>

                    <div style="margin-top:12px;">
                        <label>Items</label>
                        <table id="cotItemsTable" style="width:100%; border-collapse: collapse; margin-top:8px;">
                            <thead>
                                <tr style="background:#f5f5f5;">
                                    <th style="padding:8px; text-align:left;">Descripción</th>
                                    <th style="padding:8px; width:100px;">Cantidad</th>
                                    <th style="padding:8px; width:140px;">Precio Unitario</th>
                                    <th style="padding:8px; width:120px;">Total</th>
                                    <th style="padding:8px; width:80px;"></th>
                                </tr>
                            </thead>
                            <tbody id="cotItemsBody">
                                <tr>
                                    <td><input type="text" class="cot-desc" placeholder="Descripción"></td>
                                    <td><input type="number" class="cot-cant" value="1" min="1"></td>
                                    <td><input type="number" class="cot-precio" value="0" step="0.01" min="0"></td>
                                    <td class="cot-total">$0.00</td>
                                    <td><button type="button" class="btn btn-danger" onclick="eliminarItemCot(this)">Eliminar</button></td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="margin-top:8px; text-align:right;">
                            <button type="button" class="btn btn-secondary" onclick="agregarItemCot()">Agregar</button>
                        </div>
                        <div style="margin-top:12px; display:flex; justify-content:flex-end; align-items:center; gap:14px;">
                            <input type="checkbox" id="cotAplicaIVA" checked style="display:none">
                            <button type="button" class="btn btn-success" id="cotBtnIVA" onclick="toggleIVACot('')">IVA: Incluido (16%)</button>
                            <span style="display:flex; align-items:center; gap:6px;"><strong>Descuento ($):</strong> <input type="number" id="cotDescuento" value="0" step="0.01" min="0" style="width:100px;" oninput="actualizarTotalesCot()"></span>
                            <span><strong>Subtotal: </strong><span id="cotSubtotal">$0.00</span></span>
                        </div>
                    </div>

                    <div style="margin-top:12px;">
                        <label for="cotNotas">Notas de la propuesta (Editable)</label>
                        <textarea id="cotNotas" rows="3" placeholder="Observaciones, tiempos de entrega, alcance del servicio o condiciones especiales." style="width:100%; margin-top:6px; padding:8px 10px; border:1px solid #ccc; border-radius:4px; font-family:inherit; font-size:14px; resize:vertical;"></textarea>
                    </div>

                    <div style="margin-top:16px; display:flex; gap:10px;">
                        <button type="button" class="btn btn-primary" onclick="generarCotizacionPDF()">Impresión</button>
                        <button type="button" class="btn btn-warning" onclick="previewCotizacion()">Previsualizar</button>
                        <button type="button" class="btn btn-success" id="cotBtnDescargar" onclick="descargarCotizacionPDF()">Descargar PDF</button>
                    </div>
                </form>
            </div>

            <!-- Módulo Celosía -->
