                    <div style="margin-top:16px;">
                        <label class="servicio-selector-title">Tipo de Servicio</label>
                        <div class="servicio-selector">
                            <label><input type="checkbox" id="cotServRefacciones_bordado"> Refacciones</label>
                            <label><input type="checkbox" id="cotServTecnico_bordado"> Servicio técnico</label>
                            <label><input type="checkbox" id="cotServPreventivo_bordado"> Mantenimiento Preventivo</label>
                            <label><input type="checkbox" id="cotServCorrectivo_bordado"> Mantenimiento correctivo</label>
